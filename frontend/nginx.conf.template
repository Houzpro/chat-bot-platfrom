server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # All tunables below come from the project .env via compose → nginx envsubst.
    # The list of substituted variables is pinned in docker-compose.yml to avoid
    # clobbering runtime nginx variables like $host / $remote_addr.
    client_max_body_size ${BODY_LIMIT};

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Re-resolve `backend` on every request via Docker's embedded DNS at
    # 127.0.0.11 — without this, nginx caches the IP from startup and breaks
    # whenever the backend container is recreated and gets a new IP.
    # Using a variable in proxy_pass forces nginx to defer DNS lookup to runtime.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream "backend:${BACKEND_PORT}";

    # Proxy API requests to backend. The regex location captures the path
    # after /api/ as $1 so we can rebuild the URL with the runtime-resolved
    # upstream — required because nginx silently drops the URI rewrite from
    # `proxy_pass http://var/path` when the URL contains a variable.
    location ~ ^/api/(.*)$ {
        proxy_pass http://$backend_upstream/api/$1$is_args$args;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout ${HTTP_TIMEOUT_SEC}s;
        proxy_send_timeout ${HTTP_TIMEOUT_SEC}s;
        proxy_request_buffering off;
        proxy_buffering off;
        chunked_transfer_encoding on;
    }

    # SPA routing - all routes go to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
