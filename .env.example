# ============================================================================
# UNIFIED CONFIGURATION FOR RAG CHAT PLATFORM — TEMPLATE
# ============================================================================
# Скопируй этот файл в .env и заполни секреты. .env в git не коммитится.
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# MICROSERVICES PORTS & URLs
# ----------------------------------------------------------------------------
BACKEND_PORT=8080
DOCUMENT_PARSER_PORT=8081
VECTOR_DB_PORT=8082
AI_SERVICE_PORT=8000
FRONTEND_PORT=3000

DOC_PARSER_URL=http://document-parser:8081
VECTOR_URL=http://vector-db:8082
AI_URL=http://ai-service:8000

# ----------------------------------------------------------------------------
# LLAMA.CPP SERVER
# ----------------------------------------------------------------------------
LLAMA_CPP_PORT=8090
GGUF_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
GGUF_MODEL_PATH=./models/Qwen3.5-4B-Q4_K_M.gguf
N_CTX=32768
N_THREADS=6
N_GPU_LAYERS=0
LLAMA_PARALLEL=2

# No-think mode (universal across models).
# LLAMA_REASONING_BUDGET:
#   -1 = default (model decides / thinking allowed)
#    0 = force no-think (skip reasoning block entirely)
#   >0 = max reasoning tokens
# LLAMA_CHAT_TEMPLATE_KWARGS: JSON passed to chat template.
#   Qwen3: '{"enable_thinking": false}'
#   DeepSeek-R1 / GLM: '{"thinking": false}'
#   Default '{}' — no overrides.
LLAMA_REASONING_BUDGET=0
LLAMA_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}

# ----------------------------------------------------------------------------
# MODEL REGISTRY / FINETUNED CONTAINERS
# ----------------------------------------------------------------------------
# Absolute HOST path to ./models. Required so the backend can spawn
# llama.cpp child containers that bind-mount the same directory — Docker
# rejects relative paths when the request comes through the daemon socket.
#
# Examples:
#   Linux/macOS: /home/user/projects/chat-bot-platfrom/models
#   Windows:     C:/files/Developing/diplom/chat-bot-platfrom/models
#                (forward slashes are fine; backslashes need escaping)
#
# If left unset, docker-compose substitutes ${PWD}/models — works in bash
# but PowerShell does not export PWD, so set it explicitly on Windows.
LLAMA_MODELS_HOST_DIR=

# Port range the container manager picks from for child llama.cpp servers.
LLAMA_PORT_MIN=8100
LLAMA_PORT_MAX=8199

# ----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ----------------------------------------------------------------------------
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
# SECRET — replace before deploying
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://chatbot:change-me@postgres:5432/chatbot?sslmode=disable
# SECRET — must be at least 32 chars; replace before deploying
JWT_SECRET=change-me-must-be-at-least-32-characters-long

# System admin bootstrap. On startup, backend ensures a user with this email
# exists with role='admin'. If the user doesn't exist and ADMIN_PASSWORD is
# set, it's created automatically (so a fresh install lands with a working
# admin login). If the user already exists, only the role is updated.
# Change these BEFORE deploying — defaults are insecure.
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=change-me-admin

# ----------------------------------------------------------------------------
# VECTOR DATABASE (Qdrant)
# ----------------------------------------------------------------------------
QDRANT_HOST=qdrant
QDRANT_PORT_REST=6333
QDRANT_PORT_GRPC=6334
QDRANT_COLLECTION_SIZE=768

# ----------------------------------------------------------------------------
# GENERATION DEFAULTS
# ----------------------------------------------------------------------------
GEN_MAX_NEW_TOKENS=8192
GEN_TEMPERATURE=0.7
GEN_TOP_P=0.8
GEN_TOP_K=20
GEN_DO_SAMPLE=true
GEN_PRESENCE_PENALTY=1.5
GEN_FREQUENCY_PENALTY=0
GEN_MIN_P=0
GEN_SYSTEM_BASE_PROMPT=DO NOT use markdown formatting, asterisks, or special symbols. Use plain text only with clear paragraph breaks and natural structure.
GEN_USER_PROMPT=You are a highly knowledgeable and precise assistant. Provide comprehensive, detailed, and well-structured answers based on the given context. Include all relevant information and explain concepts thoroughly.
GEN_STOP_SEQUENCES=<|im_end|>,<|endoftext|>

# ----------------------------------------------------------------------------
# EMBEDDINGS & RERANKING
# ----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_CACHE_FOLDER=./models/embedding
USE_RERANKER=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hugging Face access token — used at build time (model download) and at runtime.
# Get one at https://huggingface.co/settings/tokens (Read scope is enough).
# SECRET — leave empty if not needed; required only for gated/private models.
HF_TOKEN=

# ----------------------------------------------------------------------------
# RAG CONFIGURATION
# ----------------------------------------------------------------------------
RAG_MAX_DOC_CHARS=50000
RAG_MAX_CONTEXT_CHARS=30000
RAG_SCORE_THRESHOLD=0.0
RAG_MAX_RESULTS=20
RELEVANCE_ESCALATION_THRESHOLD=3.0
EMBEDDING_SIMILARITY_AUTOPASS=0.75

# Hybrid Search (Vector + BM25)
USE_HYBRID_SEARCH=true
BM25_WEIGHT=0.40
VECTOR_WEIGHT=0.60

# RAG context timeout (seconds to wait for embedding + search)
RAG_CONTEXT_TIMEOUT_SEC=45

# Chat context window (number of recent messages sent to model)
CHAT_CONTEXT_WINDOW=5

# Document chunking
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ----------------------------------------------------------------------------
# DOCUMENT PROCESSING
# ----------------------------------------------------------------------------
# Max size of a single uploaded file in bytes (20 MB)
MAX_FILE_SIZE=20971520
# Fiber BodyLimit must be >= MAX_FILE_SIZE (a little headroom for multipart overhead)
BODY_LIMIT=26214400
# Comma-separated list of allowed file extensions (with leading dot)
ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.doc,.csv,.xlsx,.json,.md,.html

# ----------------------------------------------------------------------------
# HTTP CLIENT SETTINGS
# ----------------------------------------------------------------------------
HTTP_TIMEOUT_SEC=300

# ----------------------------------------------------------------------------
# CORS SETTINGS
# ----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization

# ----------------------------------------------------------------------------
# LOGGING & METADATA
# ----------------------------------------------------------------------------
LOG_LEVEL=info
APP_NAME=RAG Chat Platform
APP_VERSION=2.0.0
ENVIRONMENT=production
